{
    "version": 4,
    "configurations": [
        {
            "name": "Prospero",
            "cppStandard": "c++20",
            "defines": [
                "_CRT_SECURE_NO_WARNINGS",
                "_CRT_NONSTDC_NO_WARNINGS",
                "NOMINMAX"
            ],
            "includePath": [
                "${env:QTDIR}/include/**",
                "${env:LIBRARIES_DIR}/eigen/include",
                "${workspaceFolder}/build/**/qdstest/qdstest_autogen/include",
                "${workspaceFolder}",
                "${default}"
            ]
        }
    ]
}
